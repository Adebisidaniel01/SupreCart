# Copy this file to .env.local and add the Supabase project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: buyer storefront URL when hosting seller-portal as a separate site.
VITE_MARKETPLACE_URL=
# Optional: exact email-verification/password-reset callback URL for the seller portal.
# Embedded app example: http://127.0.0.1:8081/sellers
# Standalone seller app example: http://127.0.0.1:8082/
VITE_SELLER_AUTH_REDIRECT_URL=

# Twilio verification and messaging configuration
# These are used for email/phone verification, OTP messaging, and related contact flows.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_EMAIL_FROM=
