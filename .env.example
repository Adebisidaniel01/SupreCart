# Copy this file to .env.local and add your project values.
# Optional: buyer storefront URL when hosting seller-portal as a separate site.
VITE_MARKETPLACE_URL=

# Twilio verification and messaging configuration
# These are used for email/phone verification, OTP messaging, and related contact flows.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_EMAIL_FROM=
