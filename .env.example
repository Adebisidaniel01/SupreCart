# Copy this file to .env.local and add your project values.
# Optional: buyer storefront URL when hosting seller-portal as a separate site.
VITE_MARKETPLACE_URL=

# Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
# Analytics only loads after a visitor accepts analytics cookies.
VITE_GA_MEASUREMENT_ID=

# Admin dashboard sign-in (server-side secrets; never commit real values).
# Set ADMIN_USERNAME and either ADMIN_PASSWORD (plain) or ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Optional: signs admin sessions when set (must be at least 32 characters).
# When omitted, the session key is derived from the admin credentials.
ADMIN_SESSION_SECRET=
